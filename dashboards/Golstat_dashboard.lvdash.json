{
  "datasets": [
    {
      "name": "fd07d00f",
      "displayName": "kpi_generales",
      "config": {
        "version": "1.1",
        "source": "SELECT\r\n  COUNT(DISTINCT match_id) AS total_partidos,\r\n  SUM(goals) AS total_goles,\r\n  ROUND(SUM(xg), 1) AS total_xg,\r\n  (SELECT COUNT(*) FROM golstats.gold.dim_jugador) AS total_jugadores\r\nFROM golstats.gold.estadisticas_equipo",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "a77b1298",
      "displayName": "equipos_ranking",
      "queryLines": [
        "SELECT team, SUM(goals) AS goles, ROUND(SUM(xg), 2) AS xg_total, ROUND(AVG(pass_completion_pct), 1) AS precision_pases, SUM(shots) AS tiros \r\n",
        "FROM golstats.gold.estadisticas_equipo \r\n",
        "GROUP BY team \r\n",
        "ORDER BY goles DESC"
      ]
    },
    {
      "name": "09017009",
      "displayName": "goalscorers",
      "queryLines": [
        "SELECT player, matches_played, goals, ROUND(xg, 2) AS xg, shots \r\n",
        "FROM golstats.gold.player_tournament \r\n",
        "ORDER BY goals DESC \r\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "eb2a6abf",
      "displayName": "playmakers",
      "queryLines": [
        "SELECT player, matches_played, passes, completed_passes, ROUND(pass_completion_pct, 1) AS precision_pct \r\n",
        "FROM golstats.gold.player_tournament \r\n",
        "WHERE passes > 100 \r\n",
        "ORDER BY passes DESC \r\n",
        "LIMIT 15"
      ]
    }
  ],
